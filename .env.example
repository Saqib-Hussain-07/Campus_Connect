# CampusConnect Environment Configuration Template
# Copy this file to .env and fill in your environment values

# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection String
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# JSON Web Token Secret (REQUIRED - Must be strong random string)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://campus-connect-sigma-six.vercel.app,http://localhost:5173,http://localhost:3000

# Cloud Storage Credentials (Optional - Cloudinary/S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
